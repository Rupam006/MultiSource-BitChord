{
  "id": "dev.multisource.bitchord",
  "name": "MultiSource",
  "version": "1.0.0",
  "description": "Aggregated music search with quality-aware provider failover and Stereo / Dolby Atmos preference labels.",
  "resources": ["search", "stream"],
  "bitchordAuth": true,
  "checkValidLossless": 0,
  "allowDownloads": 1,
  "settings": [
    {
      "key": "quality",
      "type": "select",
      "label": "Audio quality",
      "default": "lossless",
      "options": [
        { "label": "Hi-Res (up to 24-bit / 192 kHz)", "value": "lossless" },
        { "label": "High Lossless (up to 24-bit / 96 kHz)", "value": "high" },
        { "label": "Low (up to 320 kHz)", "value": "low" }
      ]
    },
    {
      "key": "atmos",
      "type": "select",
      "label": "Spatial audio (shown in quality label)",
      "default": "stereo",
      "options": [
        { "label": "Stereo", "value": "stereo" },
        { "label": "Dolby Atmos when available", "value": "auto" }
      ]
    }
  ]
}
